{
  "name": "nutrikid-mern",
  "version": "1.0.0",
  "description": "Doctor-Guided Pediatric Nutrition Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "ai": "cd nutrikid_Agentic && uvicorn api:app --reload --port 8000",
    "vision": "cd ai-services/food-recognition && python -m uvicorn main:app --reload --port 8001",
    "dev": "concurrently \"npm run server\" \"npm run client\" \"npm run ai\" \"npm run vision\"",
    "start-project": "npm run dev",
    "start-frontend": "npm run client",
    "start-backend": "npm run server",
    "start-ai": "npm run ai",
    "start-vision": "npm run vision",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "mern",
    "nutrition",
    "pediatric",
    "health"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "express-async-handler": "^1.2.0",
    "gsap": "^3.15.0"
  }
}
