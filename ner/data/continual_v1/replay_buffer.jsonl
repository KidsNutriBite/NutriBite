{"id": "nutri_rag_00862", "source_record_id": "RAG_FDN_003", "text": "Combining accessible staples like parboiled brown rice or whole wheat atta with yellow split moong dal, seasonal dark leafy greens like palak or chaulai, a serving of fresh homemade dahi (curd), and a sliced amla or guava provides sustained complex carbohydrates, complete complementary proteins, bioavailable dairy calcium, dietary vitamin C, and provitamin A carotenoids.", "tokens": ["Combining", "accessible", "staples", "like", "parboiled", "brown", "rice", "or", "whole", "wheat", "atta", "with", "yellow", "split", "moong", "dal", ",", "seasonal", "dark", "leafy", "greens", "like", "palak", "or", "chaulai", ",", "a", "serving", "of", "fresh", "homemade", "dahi", "(", "curd", ")", ",", "and", "a", "sliced", "amla", "or", "guava", "provides", "sustained", "complex", "carbohydrates", ",", "complete", "complementary", "proteins", ",", "bioavailable", "dairy", "calcium", ",", "dietary", "vitamin", "C", ",", "and", "provitamin", "A", "carotenoids", "."], "bio_tags": ["O", "O", "O", "O", "O", "O", "B-FOOD", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "B-FOOD", "O", "O", "O", "O", "O", "O", "O", "O", "O", "O", "B-NUTRIENT", "I-NUTRIENT", "O", "O", "O", "B-NUTRIENT", "O", "B-DIETARY_PROPERTY", "O", "B-NUTRIENT", "O", "O", "B-NUTRIENT", "I-NUTRIENT", "O", "O", "O", "O", "O", "O"], "entities": [{"start": 50, "end": 54, "label": "FOOD", "text": "rice"}, {"start": 188, "end": 192, "label": "FOOD", "text": "curd"}, {"start": 241, "end": 262, "label": "NUTRIENT", "text": "complex carbohydrates"}, {"start": 287, "end": 295, "label": "NUTRIENT", "text": "proteins"}, {"start": 297, "end": 309, "label": "DIETARY_PROPERTY", "text": "bioavailable"}, {"start": 316, "end": 323, "label": "NUTRIENT", "text": "calcium"}, {"start": 333, "end": 342, "label": "NUTRIENT", "text": "vitamin C"}], "schema_version": "2.0"}
